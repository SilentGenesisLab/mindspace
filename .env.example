# 数据库
DATABASE_URL=postgres://mindspace:CHANGE_ME@127.0.0.1:5432/mindspace

# 会话签名密钥（openssl rand -hex 32）
AUTH_SECRET=CHANGE_ME

# OpenRouter：关系判断用 jev，定时审校用 ds4.1
OPENROUTER_API_KEY=sk-or-v1-xxx
JEV_MODEL=typesafe/jev-router
AUDIT_MODEL=deepseek/deepseek-v4.1-flash
TREE_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE=https://openrouter.ai/api/v1

# 阿里云短信
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=深圳市洞墟科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_296885677

# 站点
APP_URL=https://mindspace.sligenai.cn
# 首次验收可放开固定验证码，接入短信后务必删除
ALLOW_DEV_CODE=0
DEV_LOGIN_CODE=888888

# 审校节奏
AUDIT_INTERVAL_MIN=30
AUDIT_BATCH=15

# 飞书部署通知（可选）
FEISHU_WEBHOOK=
